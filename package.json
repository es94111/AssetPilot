{
  "name": "bookkeeping-app",
  "version": "4.33.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run typecheck && next build --webpack",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "start": "next start",
    "test": "npm run test:tz && npm run test:photo-crypto && npm run test:info-board && npm run test:dashboard-insights && npm run test:dashboard-preferences && npm run test:dashboard-forecast && npm run test:mcp-auth && npm run test:mcp-oauth && npm run test:mcp-descriptors && npm run test:stock-helpers && npm run test:dashboard-helpers && npm run check:iso && npm run check:i18n",
    "test:tz": "node tests/lib/userTime.test.ts",
    "test:photo-crypto": "node tests/lib/photoCryptoCore.test.ts",
    "test:info-board": "node tests/lib/fullMoonInfoBoard.test.ts",
    "test:dashboard-insights": "node tests/lib/dashboardInsights.test.ts",
    "test:dashboard-preferences": "node tests/lib/dashboardPreferences.test.ts",
    "test:dashboard-forecast": "node tests/lib/dashboardForecast.test.ts",
    "test:mcp-auth": "node --experimental-transform-types --import ./tests/setup/register.mjs tests/lib/mcpAuth.test.ts",
    "test:mcp-oauth": "node --experimental-transform-types --import ./tests/setup/register.mjs tests/lib/mcpOAuth.test.ts",
    "test:mcp-descriptors": "node --experimental-transform-types --import ./tests/setup/register.mjs tests/lib/mcpDescriptors.test.ts",
    "test:stock-helpers": "node --experimental-transform-types --import ./tests/setup/register.mjs tests/lib/stockHelpers.test.ts",
    "test:dashboard-helpers": "node --experimental-transform-types --import ./tests/setup/register.mjs tests/lib/dashboardHelpers.test.ts",
    "check:iso": "node tools/check-iso-utc-format.ts",
    "i18n:generate": "node tools/generate-shared-i18n.mjs && cd mobile && flutter gen-l10n",
    "check:i18n": "node tools/generate-shared-i18n.mjs --check && node tools/check-i18n-parity.ts",
    "check:sla": "node tools/sla-monthly-report.ts",
    "rotate:photo-key": "node tools/rotate-photo-master-key.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@passwordless-id/webauthn": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "decimal.js": "^10.6.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.19.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "uuid": "^14.0.1",
    "sharp": "^0.35.3",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "autoprefixer": "^10.5.4",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2"
  }
}
