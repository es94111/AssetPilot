# ==========================================
# OS-specific files (作業系統專屬檔案)
# ==========================================
# macOS 系統用來儲存資料夾自訂屬性（如圖示位置）的隱藏檔案
.DS_Store
# Windows 系統用來快取圖片縮圖的檔案
Thumbs.db

# ==========================================
# Logs and temporary files (日誌與暫存檔案)
# ==========================================
# 應用程式或系統日誌檔目錄 (目前已取消忽略，可能是您開發時需要保留追蹤)
#*.log
#logs/
# 各大 Node.js 套件管理員在發生崩潰或錯誤時留下的除錯紀錄檔
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Node.js / React / Next.js
# ==========================================
# 存放專案所有的相依套件，體積龐大且可隨時透過 package.json 
node_modules/
# Next.js 框架在開發伺服器運行或編譯時產生的建置資料夾
.next/
# 靜態網頁匯出或編譯後的最終產物資料夾 (目前已取消忽略)
#out/
#dist/
# 套件管理員的本機快取，用來加速後續安裝
.cache/
.npm/
# Yarn Plug'n'Play 模式下自動生成的依賴解析機制檔案
.pnp*
.pnp.js

# ==========================================
# TypeScript
# ==========================================
# 漸進式編譯產生的狀態快取檔，能大幅加速 TS 專案的後續編譯速度
*.tsbuildinfo

# ==========================================
# Python / FastAPI / Alembic
# ==========================================
# Python 執行腳本時自動編譯的位元組碼 (bytecode) 與 C 語言擴充模組動態連結檔
__pycache__/
*.py[cod]
*.so
# 某些虛擬環境工具用來標記環境狀態的檔案
.Python
# 型別檢查工具 mypy 與測試框架 pytest 產生的分析與測試紀錄快取
.mypy_cache/
.pytest_cache/
# 測試覆蓋率報告的數據檔案
.coverage
*.cover
# 存放本機隔離虛擬環境與相依套件的資料夾
.venv/
venv/
env/
# 套件打包與安裝時產生的詮釋資料 (metadata) 目錄
*.egg-info/
# pip 執行安裝與移除過程中的暫存與日誌檔
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# Alembic migrations (keep versions/ but ignore SQLite DBs)
# ==========================================
# 資料庫遷移工具執行腳本時產生的位元組碼
alembic/__pycache__/
migrations/__pycache__/
# 開發時常使用的本機 SQLite 資料庫檔案，避免測試資料外洩至遠端
migrations/*.sqlite

# ==========================================
# Docker
# ==========================================
# 開發者本機專屬的容器設定覆寫檔，通常用來掛載本機路徑或修改連接埠
docker-compose.override.yml
# 存放本機環境變數與敏感資訊（如資料庫密碼、API 金鑰），防止重大資安外洩
.env
.envrc

# ==========================================
# PostgreSQL
# ==========================================
# SQL 腳本修改過程中的編輯器暫存檔
*.sql~
# 資料庫匯出的備份檔，檔案可能極大且含有真實環境的敏感數據
*.dump
*.backup
# 在本機運行 PostgreSQL 時，用來持久化儲存實際資料庫內容的掛載目錄
pgdata/
postgres_data/
postgresql/
# 處理程序 ID 與 Unix socket 檔案，代表服務正在運行的動態標記檔
*.pid
*.sock

# ==========================================
# Git
# ==========================================
# Git 版本控制系統的核心資料夾
.git/
# 反向規則：強制讓 Git 追蹤專案中的空資料夾（透過放入 .gitkeep 檔案）
!.gitkeep

# ==========================================
# claude-flow / ruflo local tooling state (本機 AI 協作工具狀態，非專案內容)
# ==========================================
.claude-flow/
.swarm/

# ==========================================
# Editor and system files (編輯器與系統檔案)
# ==========================================
# VS Code 與 JetBrains 系列 IDE 的本機工作區設定檔 (目前已取消忽略)
#.vscode/
#.idea/
# Vim 編輯器在開啟與編輯檔案時自動產生的暫存與還原檔
*.swp
*.swo
*.swn
# 各種軟體或腳本在修改檔案前自動建立的備份檔 (目前已取消忽略)
#*.bak
openapi.cloudflare.yaml
release.jks.base64.txt
.gitignore
release.jks
data_safety_sample.csv
.codex/config.toml
.gitignore
.gitignore
.gitignore
.gitignore
.gitignore
