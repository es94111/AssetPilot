# 伺服器設定
PORT=3000

# JWT 設定
JWT_SECRET=your-secret-key-here
JWT_EXPIRES=7d

# Google SSO 設定（至 Google Cloud Console 取得）
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth redirect_uri 白名單（FR-011）
# 逗號分隔；必須與 Google Cloud Console > OAuth 2.0 Client > Authorized redirect URIs 完全一致
# 預設空字串時 server 會 fallback 至 [https://<APP_HOST>/api/auth/google, http://localhost:<PORT>/api/auth/google]
# 範例：https://app.your-domain.tld/api/auth/google,http://localhost:3000/api/auth/google
GOOGLE_OAUTH_REDIRECT_URIS=

# LINE Login 設定（至 LINE Developers Console 取得；僅使用 LINE Login 官方 API v2.1）
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# LINE 官方帳號 Messaging API 設定
# Webhook URL：https://your-domain.com/api/line/webhook
# LINE_MESSAGING_CHANNEL_SECRET 未設定時會 fallback 使用 LINE_CHANNEL_SECRET；正式環境建議填 Messaging API channel secret
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# LINE OAuth redirect_uri 白名單
# 逗號分隔；必須與 LINE Developers Console > LINE Login > Callback URL 完全一致
# 範例：https://app.your-domain.tld/auth/line/callback
LINE_OAUTH_REDIRECT_URIS=

# Cloudflare Turnstile（登入頁真人驗證；兩者都設定後才會啟用）
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Play Integrity API（Android App 登入／註冊時的裝置/App 完整性驗證）
# 前置作業：Google Play Console > App integrity 啟用 Play Integrity 並連結 Google Cloud 專案；
#           於該 Cloud 專案啟用 Play Integrity API，建立服務帳戶金鑰（JSON）。
# PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON：把整份服務帳戶金鑰 JSON 貼成單行字串（含 \n 跳脫的 private_key）。
#   未設定時整個功能停用、登入／註冊維持原樣放行（fail-open）。
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# App 套件名（預設 com.assetpilot.assetpilot）
PLAY_INTEGRITY_PACKAGE_NAME=com.assetpilot.assetpilot
# 強制模式：true 時驗證未通過會擋下登入／註冊；預設 false（軟性上線：僅記錄、放行）。
# 建議先觀察 log 一段時間、確認正常使用者多為通過後再切為 true。
PLAY_INTEGRITY_ENFORCE=false

# 對外主機名（Passkey RP ID 推導 / Google redirect_uri fallback 推導）
# 正式部署時請填實際網域，例如：app.your-domain.tld
APP_HOST=localhost

# PostgreSQL 資料庫（必填）
DATABASE_URL=postgres://assetpilot:assetpilot@localhost:5432/assetpilot
# POSTGRES_URL 可作為 DATABASE_URL 的替代名稱
# POSTGRES_URL=
# POSTGRES_SYNC_RESULT_BUFFER_BYTES=67108864

# 匯率 API 設定
# 預設使用免費版 API（無需 key）；若需更高配額或 webhook 功能，可至 https://www.exchangerate-api.com 申請付費 key
EXCHANGE_RATE_API_KEY=free

# MEGA S4 物件儲存備份（管理員「資料匯出匯入」頁手動上傳 PostgreSQL SQL 備份）
# 需先在 MEGA S4 Dashboard 建立 bucket 與 access key；端點會依 region 預設為 https://s3.<region>.s4.mega.io
# 支援 region：eu-central-1 / eu-central-2 / ca-central-1 / ca-west-1
MEGA_S4_ACCESS_KEY_ID=
MEGA_S4_SECRET_ACCESS_KEY=
MEGA_S4_BUCKET=
MEGA_S4_REGION=eu-central-1
MEGA_S4_PREFIX=assetpilot
# MEGA_S4_ENDPOINT=https://s3.eu-central-1.s4.mega.io

# 交易照片附件
# 預設可選 Server 本機儲存，檔案存於 <專案目錄>/uploads/transaction-photos
# 若要在新增交易時選 S3 相容物件儲存，請設定 TRANSACTION_PHOTO_S3_*；未設定時會 fallback 使用 MEGA_S4_* 作為照片 S3 目的地
TRANSACTION_PHOTO_LOCAL_DIR=
TRANSACTION_PHOTO_MAX_BYTES=10485760
# LINE 新增交易照片與其他非互動上傳流程使用的預設儲存位置：local / s3
TRANSACTION_PHOTO_DEFAULT_STORAGE=local
TRANSACTION_PHOTO_S3_ACCESS_KEY_ID=
TRANSACTION_PHOTO_S3_SECRET_ACCESS_KEY=
TRANSACTION_PHOTO_S3_BUCKET=
TRANSACTION_PHOTO_S3_REGION=eu-central-1
TRANSACTION_PHOTO_S3_ENDPOINT=
TRANSACTION_PHOTO_S3_PREFIX=assetpilot/transaction-photos

# CORS 允許來源（逗號分隔，留空則不限制）
# 正式環境建議設定，例如：https://asset.shao.one,http://localhost:3000
ALLOWED_ORIGINS=

# 管理員 IP 白名單（逗號分隔，可留空）
# 白名單 IP 將略過 API 速率限制，避免管理員被誤封鎖
ADMIN_IP_ALLOWLIST=

# SSL 憑證根目錄（Docker 部署時建議指向 Volume 路徑，確保憑證持久化）
# 預設：<專案目錄>/SSL/   Docker 預設：/app/data/SSL/（已由 Dockerfile 的 ENV SSL_PATH 設定）
# SSL_PATH=/app/data/SSL

# Cloudflare Origin Certificate 路徑（透過管理員面板上傳並儲存於 SSL/Origin Certificates/）
# SSL_CERT=SSL/Origin Certificates/server.pem
# SSL_KEY=SSL/Origin Certificates/server.key

# 寄信通道（用於管理員寄送資產統計報表）
# 支援三種：smtp / zeabur / resend；以下兩個變數指定主要與備用通道（皆可留空，留空則停用該通道）
# - PRIMARY 留空：寄信功能停用
# - FALLBACK 留空或與 PRIMARY 相同：不啟用 fallback
# - PRIMARY 執行期失敗時若 FALLBACK 已設定才會自動退回（不重試、不補寄）
EMAIL_PROVIDER_PRIMARY=
EMAIL_PROVIDER_FALLBACK=

# 寄信人顯示名稱（三通道共用，例：AssetPilot、我的記帳系統）
# 設定後信件寄件人會顯示為「名稱 <email>」；若下方任一 FROM 變數已是「Name <email>」格式則不覆寫該通道
EMAIL_SENDER_NAME=AssetPilot

# SMTP 寄信（搭配 EMAIL_PROVIDER_*=smtp 使用）
# 範例：Gmail 587（STARTTLS，SMTP_SECURE=false）或 465（TLS，SMTP_SECURE=true）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AssetPilot <noreply@example.com>

# Zeabur Email / ZSend（搭配 EMAIL_PROVIDER_*=zeabur 使用）
# 文件：https://zeabur.com/docs/en-US/email/quick-start
# API Key 至 Zeabur 控制台 > Email > API Keys 取得；FROM_EMAIL 必須是已驗證的寄件網域
ZEABUR_API_KEY=
ZEABUR_FROM_EMAIL=AssetPilot <noreply@example.com>

# Resend 寄信服務（搭配 EMAIL_PROVIDER_*=resend 使用）
# API Key 可至 https://resend.com/api-keys 取得；FROM 必須是已驗證的網域信箱
RESEND_API_KEY=
RESEND_FROM_EMAIL=AssetPilot <noreply@example.com>

# 統計報表信件 CTA 按鈕網址（留空則信件不顯示「前往儀表板」按鈕）
# 範例：https://asset.shao.one
APP_URL=

# 版本更新檢查 URL 固定由系統內建，不提供環境變數覆蓋

# ipinfo.io 查詢 Token（可留空採匿名額度，FR-041 國家代碼 fallback）
IPINFO_TOKEN=

# TWSE 並發查詢上限，預設 5；管理員可調節以避免被 rate limit
# 影響範圍：批次查價、同步除權息（年份分批內部）、排程補產生（每期歷史股價查詢）、Modal 自動回填
TWSE_MAX_CONCURRENCY=5
