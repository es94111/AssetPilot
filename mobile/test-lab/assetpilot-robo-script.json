[
  {
    "id": 1000,
    "description": "AssetPilot pre-crawl reset. Clears local app data so Test Lab starts from the login screen, then disables the soft keyboard to keep fields and buttons visible.",
    "crawlStage": "pre_crawl",
    "actions": [
      {
        "eventType": "ADB_SHELL_COMMAND",
        "command": "pm clear __%APP_PACKAGE_NAME%__"
      },
      {
        "eventType": "DISABLE_KEYBOARD"
      }
    ]
  },
  {
