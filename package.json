{
  "name": "bookkeeping-app",
  "version": "4.33.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run typecheck && next build --webpack",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "start": "next start",
    "test": "npm run test:tz && npm run test:photo-crypto && npm run test:info-board && npm run check:iso && npm run check:i18n",
    "test:tz": "node tests/lib/userTime.test.ts",
    "test:photo-crypto": "node tests/lib/photoCryptoCore.test.ts",
    "test:info-board": "node tests/lib/fullMoonInfoBoard.test.ts",
    "check:iso": "node tools/check-iso-utc-format.ts",
    "i18n:generate": "node tools/generate-shared-i18n.mjs && cd mobile && flutter gen-l10n",
    "check:i18n": "node tools/generate-shared-i18n.mjs --check && node tools/check-i18n-parity.ts",
    "check:sla": "node tools/sla-monthly-report.ts",
    "rotate:photo-key": "node tools/rotate-photo-master-key.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@passwordless-id/webauthn": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.2",
    "adm-zip": "^0.5.18",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "decimal.js": "^10.6.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.16",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "autoprefixer": "^10.5.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.16",
    "typescript": "^7.0.2"
  }
}
